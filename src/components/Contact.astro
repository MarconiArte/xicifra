---
import { Icon } from 'astro-icon/components';
---
<section class="relative overflow-hidden bg-surface py-32 border-t border-white/5" id="contacto">
    <div class="max-w-4xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            
            <div class="flex flex-col justify-center">
                <h2 class="text-primary font-mono text-sm tracking-[0.2em] uppercase mb-4">Inicia tu proyecto</h2>
                <h3 class="text-4xl md:text-5xl font-black text-white mb-6 tracking-tight">Hablemos de tu próximo desafío</h3>
                <p class="text-zinc-400 text-lg font-light leading-relaxed mb-10">
                    Construimos soluciones digitales potentes. Escríbenos y nuestro equipo analizará los requerimientos técnicos de tu negocio.
                </p>

            </div>

            <div class="bg-background p-8 md:p-10 border border-white/10 relative">
                <!-- Tech decorative corner -->
                <div class="absolute top-0 right-0 w-16 h-16 border-t border-r border-primary/50"></div>
                <div class="absolute bottom-0 left-0 w-16 h-16 border-b border-l border-primary/50"></div>
                
                <form id="contactForm" class="space-y-6 relative z-10">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-mono uppercase tracking-widest text-zinc-400" for="name">Nombre</label>
                            <input
                                class="w-full px-4 py-3 bg-surface border border-white/10 text-white placeholder-zinc-600 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all font-light"
                                id="name"
                                name="name"
                                placeholder="Tu nombre"
                                required=""
                                type="text"
                            />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-mono uppercase tracking-widest text-zinc-400" for="email">Email</label>
                            <input
                                class="w-full px-4 py-3 bg-surface border border-white/10 text-white placeholder-zinc-600 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all font-light"
                                id="email"
                                name="email"
                                placeholder="ejemplo@correo.com"
                                required=""
                                type="email"
                            />
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-mono uppercase tracking-widest text-zinc-400" for="subject">Asunto</label>
                        <input
                            class="w-full px-4 py-3 bg-surface border border-white/10 text-white placeholder-zinc-600 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all font-light"
                            id="subject"
                            name="subject"
                            placeholder="Tipo de proyecto"
                            required=""
                            type="text"
                        />
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-mono uppercase tracking-widest text-zinc-400" for="message">Detalles</label>
                        <textarea
                            class="w-full px-4 py-3 bg-surface border border-white/10 text-white placeholder-zinc-600 outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all min-h-[120px] resize-none font-light"
                            id="message"
                            name="message"
                            placeholder="Cuéntanos los requerimientos técnicos..."
                            required=""></textarea>
                    </div>
                    <button
                        class="w-full bg-primary text-background h-14 font-black uppercase tracking-widest hover:bg-primary-dim transition-all active:scale-[0.98] flex items-center justify-center gap-3 mt-4"
                        type="submit"
                    >
                        Iniciar Chat
                        <Icon name="lucide:message-square" class="w-5 h-5" />
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

<script>
    document.getElementById('contactForm')?.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = e.target as HTMLFormElement;
        const name = (form.elements.namedItem('name') as HTMLInputElement).value;
        const email = (form.elements.namedItem('email') as HTMLInputElement).value;
        const subject = (form.elements.namedItem('subject') as HTMLInputElement).value;
        const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value;
        
        const phoneNumber = '5492215997481';
        const text = `Hola Xicifra! Mi nombre es *${name}* (${email}).\n\n*Asunto:* ${subject}\n\n*Mensaje:*\n${message}`;
        
        const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(text)}`;
        window.open(whatsappUrl, '_blank');
    });
</script>
