---
import { Icon } from 'astro-icon/components';
---

<footer class="bg-surface border-t border-white/5 py-12">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="flex items-center gap-3">
      <img src="/marconiartelogo.png" alt="Xicifra Logo" class="w-8 h-8 object-contain" />
      <span class="text-lg font-black tracking-tight text-white">Xicifra</span>
    </div>
    <p class="text-zinc-500 text-sm">
      © 2026 Xicifra. Todos los derechos reservados.
    </p>
    <div class="flex gap-6">
      <a class="text-zinc-400 hover:text-primary transition-colors flex items-center gap-2 font-medium" href="https://www.instagram.com/xicifra/" target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:instagram" class="w-5 h-5" />
        <span>Instagram</span>
      </a>
    </div>
  </div>
</footer>
