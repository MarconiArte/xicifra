---
import { Icon } from 'astro-icon/components';
---

<section class="py-32 relative overflow-hidden bg-background" id="portfolio">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center text-center mb-20">
      <h2 class="text-primary font-mono text-sm tracking-[0.2em] uppercase mb-4">Portfolio</h2>
      <h3 class="text-4xl md:text-5xl font-black text-white tracking-tight">Creaciones Destacadas</h3>
    </div>
    
    <div class="relative min-h-[400px] flex items-center justify-center border border-white/10 bg-surface/50 group overflow-hidden">
      <!-- Grid Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      
      <div class="relative z-10 flex flex-col items-center text-center p-12 bg-background/80 backdrop-blur-sm border border-white/5">
        <div class="mb-8 text-primary">
          <Icon name="lucide:terminal" class="w-16 h-16 animate-pulse" />
        </div>
        <h4 class="text-2xl font-mono tracking-widest mb-4 text-white uppercase">SISTEMA EN CONSTRUCCIÓN</h4>
        <p class="text-lg text-zinc-400 max-w-md mb-8 font-light">
          Compilando nuestros mejores proyectos digitales. El portafolio interactivo estará disponible pronto.
        </p>
        
        <!-- Tech styled badge -->
        <div class="flex items-center gap-3 px-6 py-2 bg-primary/10 border border-primary/20 text-primary font-mono text-xs uppercase tracking-widest">
          <span class="w-2 h-2 bg-primary animate-ping"></span>
          Status: Compiling v2.0
        </div>
      </div>
    </div>
  </div>
</section>
